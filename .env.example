# Postgres (Neon). Pooled connection string used by the app at runtime (host contains "-pooler").
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/ledger?sslmode=require
# Direct (unpooled) connection used only for migrations (npm run db:migrate, drizzle-kit).
DATABASE_URL_UNPOOLED=postgres://user:password@ep-xxxx.region.aws.neon.tech/ledger?sslmode=require

# Bearer token Ma boi sends as "Authorization: Bearer <MCP_TOKEN>" to /mcp. At least 16 chars; use 32+ random bytes:
#   openssl rand -base64 32
MCP_TOKEN=

# bcrypt hash of the dashboard password. Generate with: npm run hash-password -- 'your password'
# (base64 of the hash is also accepted, handy in .env.local where "$" can get expanded)
OWNER_PASSWORD_HASH=

# Secret that signs the session cookie (HS256). At least 32 chars: openssl rand -base64 48
SESSION_SECRET=

# Vercel Blob read/write token for invoice PDFs (added automatically when you connect a Blob store in Vercel).
BLOB_READ_WRITE_TOKEN=

# All calendar logic is IST. Documented here for clarity; the app always uses Asia/Kolkata.
APP_TIMEZONE=Asia/Kolkata

# Optional
# TEST_DATABASE_URL=postgres://ledger:ledger@localhost:5432/ledger_test   # tests only; never production
# MCP_TEST_URL=http://localhost:3000/mcp                                   # run MCP tests against a live server
# MCP_RATE_LIMIT_PER_MIN=240
